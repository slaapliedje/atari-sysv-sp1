diff --git a/lib/libxview/notify/sys_select.c b/lib/libxview/notify/sys_select.c
index d1ef083..8ab8dab 100644
--- a/lib/libxview/notify/sys_select.c
+++ b/lib/libxview/notify/sys_select.c
@@ -124,6 +124,27 @@ notify_select(nfds, in0, out0, ex0, tv)
 	    ex++;
     }
 done:
+#ifdef ASV
+    /*
+     * ASV's timers tick at 1/128 s, so the time left to the next itimer
+     * expiry can come out as a full 1000000 us or a little below zero;
+     * Solaris never produced either, and the checks below would fail the
+     * whole notifier with EINVAL. Carry whole seconds, and treat an
+     * expiry already passed as "poll now".
+     */
+    if (tv != NULL) {
+	    static struct timeval ntv;
+
+	    ntv = *tv;
+	    while (ntv.tv_usec >= 1000000) {
+		    ntv.tv_usec -= 1000000;
+		    ntv.tv_sec++;
+	    }
+	    if (ntv.tv_sec < 0 || ntv.tv_usec < 0)
+		    ntv.tv_sec = ntv.tv_usec = 0;
+	    tv = &ntv;
+    }
+#endif
     /*
      * Convert timeval to a number of millseconds.
      * Test for zero cases to avoid doing arithmetic.

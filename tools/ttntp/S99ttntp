#!/sbin/sh
# /etc/rc2.d/S99ttntp - set the clock from the network at boot (sp1
# tools/ttntp). The route to the time servers is the one in
# /etc/defaultrouter, if the system has no default route of its own; the
# nameserver is /etc/resolv.conf's. ttntp -z also keeps the TT's clock chip
# on local time, as TOS keeps it.
#
# The kernel has read the chip's local time as GMT: ttntp -b moves the
# clock by the zone's offset at once, and the boot's utmp/wtmp records
# with it (else uptime counts the offset). Then the network: the first try
# is made here, before rc2 ends and init starts xdm, so the clock's step
# (hours, when the chip was set in another zone) doesn't land while the X
# server is starting. One try takes a second, or 3 s per time server that
# doesn't answer. After a power-on the network can take a minute or more
# (a BlueSCSI's WiFi has to join first), so if it isn't there keep trying,
# every 15 seconds for 10 minutes.
case "$1" in
start|'')
	[ -f /etc/TIMEZONE ] && . /etc/TIMEZONE
	/usr/local/bin/ttntp -q -b
	# (no "!" in this sh)
	if [ -s /etc/defaultrouter ]; then
		/usr/bin/netstat -rn | grep '^default' > /dev/null ||
			/usr/sbin/route add default `cat /etc/defaultrouter` 1 > /dev/null 2>&1
	fi
	if /usr/local/bin/ttntp -q -z > /dev/null 2>&1; then
		:
	else
		(
			n=1
			while [ $n -lt 40 ]; do
				sleep 15
				/usr/local/bin/ttntp -q -z > /dev/null 2>&1 && break
				n=`expr $n + 1`
			done
		) &
	fi
	;;
esac

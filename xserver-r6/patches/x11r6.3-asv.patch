diff --git a/programs/Xserver/cfb/cfb.h b/programs/Xserver/cfb/cfb.h
--- a/programs/Xserver/cfb/cfb.h
+++ b/programs/Xserver/cfb/cfb.h
@@ -902,6 +902,30 @@
 #endif
 );
 
+/*
+ * Hardware acceleration of on-screen drawing, for a ddx whose card has a
+ * 2D engine. Called for WINDOW drawables only (on screen), with GXcopy
+ * and all planes; each returns TRUE when it has done the work, FALSE to
+ * let cfb draw. NULL (the default) = no acceleration. The fill word is
+ * the PFILL()ed pixel.
+ */
+extern int (*cfbScreenBlitHook)(
+#if NeedFunctionPrototypes
+    DrawablePtr /*pSrc*/,
+    DrawablePtr /*pDst*/,
+    RegionPtr /*prgnDst*/,
+    DDXPointPtr /*pptSrc*/
+#endif
+);
+extern int (*cfbScreenFillHook)(
+#if NeedFunctionPrototypes
+    DrawablePtr /*pDrawable*/,
+    int /*nBox*/,
+    BoxPtr /*pBox*/,
+    unsigned long /*fill*/
+#endif
+);
+
 extern void cfbFillBoxSolid(
 #if NeedFunctionPrototypes
     DrawablePtr /*pDrawable*/,

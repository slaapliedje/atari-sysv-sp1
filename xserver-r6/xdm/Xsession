#!/bin/sh
# the X session (xdm runs it as the user); it ends when the window manager
# exits (OpenLook: Workspace menu, Exit; twm: Log out)
OPENWINHOME=/usr/openwin; export OPENWINHOME
# XView's Help key: its built-in default is /usr/lib/help, the system's
HELPPATH=$OPENWINHOME/lib/help; export HELPPATH
PATH=/usr/openwin/bin:/usr/x11r6/bin:$PATH:/usr/bin/X11:/usr/local/bin:/usr/local/lib/transputer/bin; export PATH
# an empty shell field in /etc/passwd (root's, on ASV) means /bin/sh, but
# xdm passes it on as an empty SHELL, and cmdtool then fails to start one.
# bash, when it is installed and runs (it is an AMIX program: it needs the
# amx module), else /bin/sh
if test -z "$SHELL"; then
	SHELL=/bin/sh
	/usr/local/bin/bash -c true 2>/dev/null && SHELL=/usr/local/bin/bash
	export SHELL
fi
test -x $HOME/.xsession && exec $HOME/.xsession
# the window manager: the one picked on the login screen (wmchooser leaves
# its name in xdm's directory, and it is kept in ~/.wm for next time), else
# ~/.wm, else everyone's default in /etc/X11/wm (setwm sets both); its
# program from /etc/X11/wms
d=`echo "$DISPLAY" | sed 's/^[^:]*:\([0-9]*\).*$/\1/'`
pick=`sed -n 1p /usr/x11r6/lib/X11/xdm/wmpick.$d 2>/dev/null`
test -n "$pick" && echo "$pick" > $HOME/.wm
wm=`sed -n 1p $HOME/.wm 2>/dev/null`
test -z "$wm" && wm=`sed -n 1p /etc/X11/wm 2>/dev/null`
# (a redirected loop runs in a subshell in this sh: its output is the answer)
prog=
if test -n "$wm" -a -f /etc/X11/wms; then
	prog=`while read n p rest; do
		if test "$n" = "$wm"; then
			echo "$p"
			break
		fi
	done < /etc/X11/wms`
fi
if test -z "$prog" -o ! -x "$prog"; then
	for prog in $OPENWINHOME/bin/olvwm $OPENWINHOME/bin/olwm /usr/x11r6/bin/twm; do
		test -x $prog && break
	done
fi
xsetroot -solid '#5f7f9f'
# OpenLook's icons along the top (olvwm's default is the bottom, where the
# panel is: the panel would cover them)
case "$prog" in
*/olvwm|*/olwm)	echo 'OpenWindows.IconLocation: top' | xrdb -nocpp -merge ;;
esac
# the window manager will have this shell's pid: ttpanel's Log out ends
# the session through it when olvwm is not there to ask
TTPANEL_WM_PID=$$; export TTPANEL_WM_PID
# a terminal, and the front panel along the bottom (ttpanel: the buttons
# come from ~/.ttpanelrc, see ttpanel.c). JWM starts the terminal itself
# once it manages windows (its StartupCommand): an xterm still starting up
# when JWM takes it over comes out at its smallest size
case "$prog" in
*/jwm)	;;
*)	xterm -geometry 80x24+30+30 & ;;
esac
ttpanel &
exec $prog

# /etc/profile.manx - Manx on this system (sourced by /etc/profile).
# HTTPS: the roots come from the CA bundle below (~/.manx/roots.bin is
# built from it); the random seed is per user.  Manx offers to make both
# on the first https page, and finds the bundle without this file too;
# `manxtrust roots FILE` and `manxtrust seed` do them by hand.
MANX_CAFILE=/usr/local/share/manx/cacert.pem
export MANX_CAFILE

#!/bin/bash
# amix-static-cc - gcc-cross-amix, but linking statically against AMIX's
# libc.a (the wrapper links only against libc.so.1, which lacks much of
# libc.a: select, getpwent, siglongjmp, ...). Compiles go to the wrapper
# unchanged; links go straight to ld. A static AMIX program needs no dynamic
# linker, so it runs on AMIX, or on Atari System V with the amx module,
# without any of AMIX's shared libraries.
#   AMIX_SYSROOT   the AMIX tree (usr/include, usr/ccs/lib/{crt*,values-Xa}.o,
#                  usr/ccs/lib/libc.a)
set -e
: "${ASV_CROSS:=$HOME/opt/asv-cross}"
: "${AMIX_SYSROOT:?set AMIX_SYSROOT}"
export AMIX_SYSROOT
cc="$ASV_CROSS/bin/m68k-cbm-sysv4-gcc"
ld="$ASV_CROSS/bin/m68k-cbm-sysv4-ld"
crt="$AMIX_SYSROOT/usr/ccs/lib"
libgcc=$(ls "$ASV_CROSS"/lib/gcc-lib/m68k-cbm-sysv4/*/libgcc.a | tail -1)

for a in "$@"; do
	case "$a" in -c|-E|-S|-M|-MM) exec "$cc" "$@";; esac
done

out=a.out link=() dirs=() cflags=() tmps=()
trap 'rm -f "${tmps[@]}"' EXIT
# -L first, so that -l can be resolved in place: ld is single-pass, so the
# objects and libraries keep their command-line order, as with gcc
prev=
for a in "$@"; do
	case "$prev" in -L) dirs+=("$a");; esac
	case "$a" in -L?*) dirs+=("${a#-L}");; esac
	prev="$a"
done
while [ $# -gt 0 ]; do
	case "$1" in
	-o) out="$2"; shift;;
	-o*) out="${1#-o}";;
	-L) shift;;
	-L*) ;;
	-lc|-lgcc) ;;
	-lm) link+=("$crt/libm.a");;
	-l*) l="${1#-l}" f=
	     for d in "${dirs[@]}" "$crt" "$AMIX_SYSROOT/usr/lib"; do
		[ -f "$d/lib$l.a" ] && { f="$d/lib$l.a"; break; }
	     done
	     [ -n "$f" ] || { echo "amix-static-cc: no static lib$l.a" >&2; exit 1; }
	     link+=("$f");;
	*.c) o=$(mktemp "${TMPDIR:-/tmp}/amixs.XXXXXX.o"); tmps+=("$o")
	     "$cc" "${cflags[@]}" -c "$1" -o "$o"; link+=("$o");;
	-I*|-D*|-U*|-O*|-m*|-f*|-W|-W[a-km-z]*|-g|-ansi|-traditional|-std=*) cflags+=("$1");;
	-static|-s|-rdynamic|-pthread) ;;
	-Wl,*) IFS=, read -ra w <<< "${1#-Wl,}"; link+=("${w[@]}");;
	*) link+=("$1");;
	esac
	shift
done
exec "$ld" -Bstatic -o "$out" "$crt/crt1.o" "$crt/crti.o" "$crt/values-Xa.o" \
	"${link[@]}" "$crt/libc.a" "$libgcc" "$crt/crtn.o"
